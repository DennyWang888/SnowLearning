<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script><![CDATA[function continueOK() {

    var gdw = GlideDialogWindow.get();
	var to_do_item =gel('to_do_item').value;
	//get the values passed in the client script 
	var sys_id = gdw.getPreference('sys_id'); 
	GlideDialogWindow.get().destroy();

	//call ajax
    var ga = new GlideAjax('UpdateToDo');
    ga.addParam('sysparm_name', 'updateToDo');
	ga.addParam('sysparm_sys_id', sys_id);
	ga.addParam('sysparm_to_do_item', to_do_item);
    ga.getXML(UpdateToDoParse);

    function UpdateToDoParse(response) {
        var answer = response.responseXML.documentElement.getAttribute("answer");
        alert(answer);
    }
}

function continueCancel() {
    alert("Cancel clicked");
    GlideDialogWindow.get().destroy();
}]]></client_script>
        <description/>
        <direct>false</direct>
