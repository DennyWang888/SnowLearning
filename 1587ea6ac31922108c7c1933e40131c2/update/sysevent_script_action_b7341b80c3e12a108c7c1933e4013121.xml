        <name>UpdateHardwareAsset</name>
        <order>100</order>
        <script><![CDATA[var newimp = event.parm1.toString();
gs.info("user id is" + newimp);

var hwAsset = new GlideRecord('alm_hardware');
hwAsset.addQuery('asset_tag', 'P1000195');
hwAsset.query();
while (hwAsset.next()) {
  gs.info('Found hardware with asset tag: ' + hwAsset.asset_tag);
  gs.info('Hardware name: ' + hwAsset.name);
  hwAsset.install_status = '1';
  hwAsset.assigned_to = newimp;
  hwAsset.update();
}
]]></script>
